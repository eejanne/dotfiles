#!/usr/bin/env bash

COLLAPSED="${FTREE_COLLAPSED:-/dev/null}"

# Subcommands used by fzf left/right bindings to toggle directory collapse state
case "$1" in
  --collapse)
    [ -d "$2" ] && { grep -qxF "$2" "$COLLAPSED" || printf '%s\n' "$2" >> "$COLLAPSED"; }
    exit 0
    ;;
  --expand)
    grep -vxF "$2" "$COLLAPSED" > "${COLLAPSED}.tmp" 2>/dev/null; mv "${COLLAPSED}.tmp" "$COLLAPSED"
    exit 0
    ;;
esac

q="$1"

if [ -z "$q" ]; then
  # Expand each file path into all ancestor directory paths so the tree has
  # explicit nodes for every level. Skip content inside collapsed directories.
  ag --hidden --ignore ".git" -g "" 2>/dev/null | awk -v cf="$COLLAPSED" '
BEGIN {
  while ((getline line < cf) > 0) collapsed[line] = 1
  close(cf)
}
{
  np = split($0, parts, "/")
  max_d = np
  for (d = 1; d < np; d++) {
    anc = ""
    for (k = 1; k <= d; k++) anc = anc (k > 1 ? "/" : "") parts[k]
    if (anc in collapsed) { max_d = d; break }
  }
  for (d = 1; d <= max_d; d++) {
    curr = ""
    for (k = 1; k <= d; k++) curr = curr (k > 1 ? "/" : "") parts[k]
    print curr
  }
}' | LC_ALL=C sort -u | awk -v cf="$COLLAPSED" '
BEGIN {
  while ((getline line < cf) > 0) collapsed[line] = 1
  close(cf)
  n = 0
}
{ paths[n] = $0; path_idx[$0] = n; n++ }
END {
  nnd[n-1] = n
  for (i = n-2; i >= 0; i--) {
    j = i + 1; prefix = paths[i] "/"; plen = length(prefix)
    while (j < n && substr(paths[j], 1, plen) == prefix) j = nnd[j]
    nnd[i] = j
  }
  for (i = 0; i < n; i++) {
    path = paths[i]; ndepth = split(path, parts, "/"); display = ""
    plen1 = length(path) + 1
    is_dir = (path in collapsed) || (i + 1 < n && substr(paths[i+1], 1, plen1) == path "/")
    for (d = 1; d <= ndepth; d++) {
      curr = ""
      for (k = 1; k <= d; k++) curr = curr (k > 1 ? "/" : "") parts[k]
      par = ""
      for (k = 1; k < d; k++) par = par (k > 1 ? "/" : "") parts[k]
      if (d > 1) par = par "/"
      j = nnd[path_idx[curr]]
      if (par == "") is_last = (j >= n)
      else is_last = (j >= n || substr(paths[j], 1, length(par)) != par)
      if (d < ndepth) display = display (is_last ? "    " : "│   ")
      else {
        if (path in collapsed) icon = "▶ "
        else icon = ""
        display = display (is_last ? "└── " : "├── ") icon parts[d]
      }
    }
    printf "%s\t%s\n", path, display
  }
}'
else
  ag --hidden --ignore ".git" -g "" | awk '{printf "%s\t%s\n", $0, $0}'
fi
